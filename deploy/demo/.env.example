# Copy to .env on the deployment host. Never commit the real value.
DEMO_SECRET_KEY=replace-with-a-long-random-secret
DEMO_PERSONAL_USERNAME=replace-with-a-deployment-only-demo-username
DEMO_PERSONAL_PASSWORD=replace-with-a-demo-only-password
DEMO_PERSONAL_ROLE=Candidate
DEMO_LOGIN_PER_MINUTE=20
DEMO_REGISTER_PER_MINUTE=8
DEMO_WRITE_PER_MINUTE=60
DEMO_MAX_USERS=100
DEMO_MAX_JOBS=300
DEMO_MAX_APPLICATIONS=2000
DEMO_MAX_SLOTS=1000
DEMO_MAX_REQUEST_BYTES=65536
